{
  "pack": "synthetic year-end style pack",
  "scenarios": [
    {
      "id": "A01",
      "title": "Date change inside a paragraph (same width)",
      "pdf": "report.pdf",
      "page": 1,
      "source_text": "financial year ending 31 December 2023",
      "replacement": "financial year ending 31 December 2024",
      "expected_safe_result": {
        "status": "updated"
      }
    },
    {
      "id": "A02",
